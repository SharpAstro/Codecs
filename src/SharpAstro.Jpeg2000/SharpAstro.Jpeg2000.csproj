<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <!-- On the name. PDF calls the filter /JPXDecode and the rest of this family
         uses format short names (Jxr, Jxl, Jbig2), so SharpAstro.Jpx was the
         obvious fit. It is not the one shipped, because "JPX" is also the name
         of JPEG 2000 Part 2 (ISO/IEC 15444-2) — the extended format with
         arbitrary colour spaces, opacity channels and multiple codestreams —
         and Part 2 is precisely what this package refuses to implement. A
         package id that names the thing it does not do is a trap for whoever
         reads the NuGet listing rather than this file. SharpAstro.Jpeg2000
         names the standard instead: uglier, unambiguous, and it stays honest
         when Part 2 keeps not arriving. PDF's filter name is in the
         description and the tags, where a search will find it. -->

    <PackageId>SharpAstro.Jpeg2000</PackageId>
    <Product>SharpAstro.Jpeg2000</Product>
    <Authors>SharpAstro</Authors>
    <Description>Pure-managed JPEG 2000 (ITU-T T.800 / ISO-IEC 15444-1, Part 1) image decoder for .NET, written clean-room from the specification and aimed at PDF's /JPXDecode filter. Decodes the raw J2K codestream and the JP2 container, registering with the SharpAstro.Codecs facade by magic bytes. AOT-compatible. Decode only, Part 1 only.</Description>
    <PackageTags>jpeg2000 jp2 j2k jpx jpxdecode t800 15444 ebcot dwt pdf image codec decoder aot</PackageTags>
    <RepositoryUrl>https://github.com/SharpAstro/Codecs.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/SharpAstro/Codecs</PackageProjectUrl>
    <PackageLicenseFile>UNLICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../UNLICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- IImageDecoder / IDecodedImage contract for the SharpAstro.Codecs facade,
         and MqDecoder: T.800 Annex C's arithmetic coder is T.88 Annex E's, so
         the two codecs share one internal copy from here. -->
    <ProjectReference Include="..\SharpAstro.Codecs.Abstractions\SharpAstro.Codecs.Abstractions.csproj" />
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpAstro.Codecs.Tests" />
  </ItemGroup>

</Project>
