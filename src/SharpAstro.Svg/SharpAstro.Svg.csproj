<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>SharpAstro.Svg</PackageId>
    <Product>SharpAstro.Svg</Product>
    <Authors>SharpAstro</Authors>
    <Description>Pure C# SVG reader for .NET that resolves a document into a SharpAstro.Vector scene (paths, fills, strokes, transforms, opacity groups) and leaves drawing to the caller: no rasteriser, no font code, not a pixel decoder. Written from the W3C SVG specifications. Reads paths, basic shapes, transforms, viewports, use and symbol, solid and gradient paints, stroke properties and style sheets, and reports everything it does not read.</Description>
    <PackageTags>svg svgz vector path parser scene aot</PackageTags>
    <RepositoryUrl>https://github.com/SharpAstro/Codecs.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/SharpAstro/Codecs</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>UNLICENSE</PackageLicenseFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpAstro.Vector\SharpAstro.Vector.csproj" />
    <InternalsVisibleTo Include="SharpAstro.Codecs.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\UNLICENSE" Pack="true" PackagePath="\" Link="UNLICENSE" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
